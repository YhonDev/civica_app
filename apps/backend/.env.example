# ─── Database ──────────────────────────────────────────
# Database connection for TypeORM (NestJS backend)
#
# Modo cloud (pooler sesion - recomendado para produccion):
#   DATABASE_HOST=aws-0-TU_REGION.pooler.supabase.com
#   DATABASE_PORT=5432
#   DATABASE_USER=postgres.TU_PROJECT_REF
#   DATABASE_PASSWORD=tu_password
#   DATABASE_NAME=postgres
#   DATABASE_SSL=require
#
# Modo local (Supabase CLI - desarrollo):
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54322
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres

# ─── Supabase ──────────────────────────────────────────
# Cloud (produccion):
#   SUPABASE_URL=https://TU_PROYECTO.supabase.co
#   SUPABASE_ANON_KEY=tu_anon_key_publica
#   SUPABASE_SERVICE_KEY=tu_service_role_key
#
# Local (Supabase CLI - desarrollo):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=tu_anon_key_local
SUPABASE_SERVICE_KEY=tu_service_key_local

# --- Auth / JWT ---
# Secreto para firmar tokens JWT (cambiar en produccion)
JWT_SECRET=tu_jwt_secret_aqui

# --- App ---
APP_PORT=3000
NODE_ENV=development

# --- Security ---
# Origenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# Limite de requests por minuto (rate limiting)
THROTTLE_LIMIT=30
