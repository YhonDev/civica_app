# ─── Database ──────────────────────────────────────────
# Database connection for TypeORM (NestJS backend)
#
# Modo cloud (pooler sesion - recomendado para produccion):
#   DATABASE_HOST=aws-0-TU_REGION.pooler.supabase.com
#   DATABASE_PORT=5432
#   DATABASE_USER=postgres.TU_PROJECT_REF
#   DATABASE_PASSWORD=tu_password
#   DATABASE_NAME=postgres
#   DATABASE_SSL=require
#
# Modo local (Supabase CLI - desarrollo):
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54322
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres

# ─── Supabase ──────────────────────────────────────────
# Cloud (produccion):
#   SUPABASE_URL=https://TU_PROYECTO.supabase.co
#   SUPABASE_ANON_KEY=tu_anon_key_publica
#   SUPABASE_SERVICE_KEY=tu_service_role_key
#
# Local (Supabase CLI - desarrollo):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=tu_anon_key_local
SUPABASE_SERVICE_KEY=tu_service_key_local

# --- Auth / JWT ---
# Secreto para firmar access tokens (generar fuera del repositorio)
# Producción: usar un secreto aleatorio de al menos 32 bytes desde el gestor de secretos.
JWT_SECRET=generar-con-un-gestor-de-secretos
# Secreto SEPARADO para firmar refresh tokens: si JWT_SECRET se compromete,
# no permite falsificar sesiones de 30 días (y viceversa).
# En producción DEBE ser distinto de JWT_SECRET. En desarrollo, si se omite,
# cae al valor de JWT_SECRET.
JWT_REFRESH_SECRET=generar-otro-secreto-distinto

# --- App ---
APP_PORT=3000
NODE_ENV=development

# --- Redis (opcional) ---
# PostgreSQL es la fuente de verdad. Redis se usa solo para revocación distribuida.
REDIS_ENABLED=false
# Solo requerido cuando REDIS_ENABLED=true
# REDIS_URL=redis://:password@host:6379/0

# --- Security ---
# Origenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# SSL de la base de datos (modo cloud: DATABASE_SSL=require)
# rejectUnauthorized verifica la CA del servidor (previene MITM). Default: true.
# Solo bajar a false en desarrollo puntual si el pooler no publica su CA.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Limite de requests por minuto (rate limiting)
THROTTLE_LIMIT=30
