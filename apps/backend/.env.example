# ─── Database ──────────────────────────────────────────
# Modo cloud (IPv6 directo)
# DATABASE_HOST=db.TU_PROYECTO.supabase.co
# DATABASE_PORT=5432

# Modo cloud (pooler - recomendado)
# DATABASE_HOST=aws-0-TU_REGION.pooler.supabase.com
# DATABASE_PORT=6543
# DATABASE_USER=postgres.TU_PROJECT_REF

# Modo local (Supabase CLI)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54322
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres

# ─── Supabase ──────────────────────────────────────────
# Cloud
# SUPABASE_URL=https://TU_PROYECTO.supabase.co
# SUPABASE_ANON_KEY=tu_anon_key_publica
# SUPABASE_SERVICE_KEY=tu_service_role_key

# Local (Supabase CLI)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=tu_anon_key_local
SUPABASE_SERVICE_KEY=tu_service_key_local

# ─── App ───────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=development
